#!/usr/bin/env python3

"""Record the fixed BlueROV sensor topic set with rosbag2."""

import argparse
import os
import sys


CAMERA_TOPIC = "/camera/image_raw"

TOPICS = [
    "/auv/dvl",
    "/auv/dvl/distance",
    "/auv/forces_actual",
    "/auv/global/velocity_actual",
    "/auv/imu/data_raw",
    "/auv/imu/magnetic_field",
    "/auv/pressure/scaled2",
    "/dvl/command/response",
    "/dvl/config/command",
    "/dvl/config/status",
    "/dvl/data",
    "/dvl/position",
    "/parameter_events",
    "/rosout",
    "/sonar/imu/data_raw",
    "/sonar_point_cloud",
]


def main() -> None:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument(
        "--camera",
        action=argparse.BooleanOptionalAction,
        default=True,
        help="record the camera image topic (default: enabled)",
    )
    options, rosbag_args = parser.parse_known_args()

    topics = [*TOPICS]
    if options.camera:
        topics.append(CAMERA_TOPIC)

    command = ["ros2", "bag", "record", *rosbag_args, "--topics", *topics]
    os.execvp(command[0], command)


if __name__ == "__main__":
    main()
